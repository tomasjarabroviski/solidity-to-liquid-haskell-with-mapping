# npm dependencies (installed with `npm install`)
node_modules/

# `cabal build` output in src/verify/ (regenerated on each machine)
dist-newstyle/

# Liquid Haskell cache and GHC artifacts
.liquid/
*.hi
*.o
*.dyn_hi
*.dyn_o
.ghc.environment.*

# OS / editors
.DS_Store

# Haskell generated by `npm run comp` (regenerated on every run)
scripts/tmp/

# LaTeX build artifacts (thesis/)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.toc
*.synctex.gz
